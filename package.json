{
  "name": "@trustless-work/escrow-js",
  "version": "1.0.0-beta.1",
  "description": "Framework-agnostic JavaScript/TypeScript client for Trustless Work Core API v2 escrows.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.mjs",
      "require": "./dist/rest.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "import": "./dist/graphql.mjs",
      "require": "./dist/graphql.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/types/index.ts src/rest.ts src/graphql.ts --format esm,cjs --dts",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Trustless-Work/trustlesswork-sdk-js.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "sdk",
    "trustless",
    "escrow",
    "stellar",
    "soroban",
    "node",
    "nestjs",
    "angular",
    "graphql",
    "api"
  ],
  "author": "Trustless Work",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.20",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
